{
  "name": "reactnativelab",
  "version": "0.0.1",
  "private": true,
  "author": "thiendo261",
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "watchman watch-del-all && react-native start --reset-cache",
    "clean:android": "cd android && ./gradlew clean && cd ..",
    "clean:ios": "cd ios && xcodebuild clean -scheme ReactNativeLab && cd ..",
    "clean:all": "yarn clean:android && yarn clean:ios",
    "log:android": "react-native log-android",
    "log:ios": "react-native log-ios",
    "xcode": "open ios/ReactNativeLab.xcworkspace",
    "test": "jest",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --check . --write",
    "commit": "cz",
    "postinstall": "patch-package && pod-install",
    "prepare": "husky install"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^1.17.3",
    "@react-native-community/netinfo": "^8.3.0",
    "@react-navigation/bottom-tabs": "^6.3.1",
    "@react-navigation/native": "^6.0.10",
    "@react-navigation/native-stack": "^6.6.1",
    "@reduxjs/toolkit": "^1.8.1",
    "dayjs": "^1.11.0",
    "i18next": "^21.6.15",
    "lodash": "^4.17.21",
    "numeral": "^2.0.6",
    "react": "17.0.2",
    "react-fast-compare": "^3.2.0",
    "react-i18next": "^11.16.3",
    "react-native": "0.68.0",
    "react-native-fast-image": "^8.5.11",
    "react-native-gesture-handler": "^2.3.2",
    "react-native-localize": "^2.2.1",
    "react-native-modal": "^13.0.1",
    "react-native-reanimated": "^2.7.0",
    "react-native-safe-area-context": "^4.2.4",
    "react-native-screens": "^3.13.1",
    "react-native-svg": "^12.3.0",
    "react-redux": "^7.2.8",
    "redux-persist": "^6.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.12.9",
    "@babel/runtime": "^7.12.5",
    "@commitlint/cli": "^16.2.3",
    "@commitlint/config-conventional": "^16.2.1",
    "@react-native-community/eslint-config": "^2.0.0",
    "@types/jest": "^26.0.23",
    "@types/lodash": "^4.14.182",
    "@types/numeral": "^2.0.2",
    "@types/react-native": "^0.67.3",
    "@types/react-test-renderer": "^17.0.1",
    "@types/readline-sync": "^1.4.4",
    "@typescript-eslint/eslint-plugin": "^5.17.0",
    "@typescript-eslint/parser": "^5.17.0",
    "babel-jest": "^26.6.3",
    "babel-plugin-module-resolver": "^4.1.0",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^7.32.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-prettier": "^4.0.0",
    "husky": ">=6",
    "jest": "^26.6.3",
    "lint-staged": ">=10",
    "metro-react-native-babel-preset": "^0.67.0",
    "patch-package": "^6.4.7",
    "pod-install": "^0.1.33",
    "postinstall-postinstall": "^2.1.0",
    "prettier": "^2.6.2",
    "react-native-svg-transformer": "^1.0.0",
    "react-test-renderer": "17.0.2",
    "readline-sync": "^1.4.10",
    "typescript": "^4.4.4"
  },
  "resolutions": {
    "@types/react": "^17"
  },
  "jest": {
    "preset": "react-native",
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json",
      "node"
    ]
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,svg,md}": [
      "yarn lint",
      "yarn format"
    ]
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
